# Secreto de la sesión (obligatorio). Generar con: openssl rand -hex 32
SECRET_SESSION=

# Credenciales de acceso al panel
USUARIO=
CONTRASENA=

# URL base de la API
URL_API=http://localhost:8000

# Orígenes permitidos por CORS, separados por coma. Vacío = sin acceso cross-origin
ALLOWED_ORIGINS=

# Puerto del servidor
PORT=3000

# production activa la cookie de sesión con secure
NODE_ENV=development
