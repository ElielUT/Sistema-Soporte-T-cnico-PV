<%- include ("templates/header") %>
    <%- include("templates/secciones", { titulo: "Mantenimientos", botones: [
        { id: "btnTodos", texto: "Tipos", activo: true },
        { id: "btnRealizados", texto: "Realizados", activo: false }
    ] }) %>

    <div class="seccion" id="tipos">
        <div class="buscador">
            <form action="" id="formBusqueda" class="formBusqueda">
                <input type="text" name="Buscar" placeholder="Buscar">
                <%- include("templates/select", { nombre: "areas", placeholder: "Todas", opciones: catalogos.areas }) %>
            </form>

            <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
        </div>

        <%- include("templates/form_nuevo", { campos: "campos/mantenimientos" }) %>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Área</th>
                    <th>Día</th>
                    <th>Mes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% data.forEach(item=> { %>
                    <tr id="<%= item.idmant %>" data-areas="<%= item.areas %>" data-dia="<%= item.dia %>"
                        data-mes="<%= item.mes %>">
                        <td>
                            <%= item.idmant %>
                        </td>
                        <td>
                            <%= item.areas %>
                        </td>
                        <td>
                            <%= item.dia %>
                        </td>
                        <td>
                            <%= item.mes %>
                        </td>
                        <%- include("templates/acciones") %>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
    </div>

    <%- include("templates/form_editar", { campos: "campos/mantenimientos" }) %>

        <script>
            window.paginaActual = "/mantenimientos"
        </script>
        <script src="js/secciones.js"></script>

        <%- include ("templates/footer") %>
