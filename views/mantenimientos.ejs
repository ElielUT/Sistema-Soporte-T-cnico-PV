<%- include ("templates/header") %>
    <div class="superior">
        <h1>Mantenimientos</h1>

        <div class="secciones">
            <button class="btn-seccion seleccionado" id="btnTodos">Tipos</button>
            <button class="btn-seccion" id="btnRealizados">Realizados</button>
        </div>
    </div>

    <div class="seccion" id="tipos">
        <div class="buscador">
            <form action="" id="formBusqueda" class="formBusqueda">
                <input type="text" name="Buscar" placeholder="Buscar">
                <select name="areas" id="">
                    <option value="">Todas</option>
                    <option value="Administración">Administración</option>
                    <option value="Soporte Técnico">Soporte Técnico</option>
                    <option value="Instituto Bíblico">Instituto Bíblico</option>
                    <option value="Alcance">Alcance</option>
                </select>
            </form>

            <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
        </div>

        <div class="ingresar ocultar modales" id="formNuevo">
            <div class="botones">
                <button class="cancelar"><b>Cancelar</b></button>
                <button class="agregar" id="agregar"><b>+ Agregar</b></button>
            </div>

            <form action="">
                <div class="dosMedio">
                    <select name="areas" id="">
                        <option value="">Seleccione un área</option>
                        <option value="Administración">Administración</option>
                        <option value="Soporte Técnico">Soporte Técnico</option>
                        <option value="Instituto Bíblico">Instituto Bíblico</option>
                        <option value="Alcance">Alcance</option>
                    </select>
                    <input type="number" name="dia" id="" placeholder="Día" min="1" max="31">
                    <input type="number" name="mes" id="" placeholder="Mes" min="1" max="12">
                </div>
            </form>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Área</th>
                    <th>Día</th>
                    <th>Mes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% data.forEach(item=> { %>
                    <tr id="<%= item.idmant %>" data-areas="<%= item.areas %>" data-dia="<%= item.dia %>"
                        data-mes="<%= item.mes %>">
                        <td>
                            <%= item.idmant %>
                        </td>
                        <td>
                            <%= item.areas %>
                        </td>
                        <td>
                            <%= item.dia %>
                        </td>
                        <td>
                            <%= item.mes %>
                        </td>
                        <td style="width: 50px; text-align: center;">
                            <i class="bi bi-trash-fill eliminar"></i>
                            <i class="bi bi-pencil-fill editar"></i>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
    </div>

    <div class="contenedorForm ocultar modales" id="formEditar">
        <div class="formEditar ingresar">
            <div class="botones">
                <button class="cancelar"><b>Cancelar</b></button>
                <button class="actualizar" id="actualizar"><b>Actualizar</b></button>
            </div>

            <form action="">
                <div class="dosMedio">
                    <select name="areas" id="">
                        <option value="">Seleccione un área</option>
                        <option value="Administración">Administración</option>
                        <option value="Soporte Técnico">Soporte Técnico</option>
                        <option value="Instituto Bíblico">Instituto Bíblico</option>
                        <option value="Alcance">Alcance</option>
                    </select>
                    <input type="number" name="dia" id="" placeholder="Día" min="1" max="31">
                    <input type="number" name="mes" id="" placeholder="Mes" min="1" max="12">
                </div>
            </form>
        </div>

        <script>
            window.paginaActual = "/mantenimientos"
        </script>
        <script src="js/secciones.js"></script>

        <%- include ("templates/footer") %>