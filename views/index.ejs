<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema Soporte Técnico PV</title>
    <link rel="icon" href="/images/logo.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * {
            padding: 0px;
            margin: 0px;
        }

        body {
            font-family: Helvetica, sans-serif;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: rgb(0, 79, 104);
        }

        .login-container {
            display: flex;
            flex-direction: column;
            justify-content: space-around;
            align-items: center;
            background-color: rgb(115, 209, 245);
            border-radius: 20px;
            height: auto;
            min-height: 400px;
            width: 28%;
            min-width: 320px;
            max-width: 450px;
            padding: 30px 20px;
            box-shadow: 0px 10px 25px rgba(0, 0, 0, 0.35);
            box-sizing: border-box;
        }

        .login-title {
            color: rgb(0, 79, 104);
            margin-top: 15px;
            margin-bottom: 20px;
            font-size: 2em;
            font-weight: bold;
            text-align: center;
        }

        .login-form {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 100%;
            align-items: center;
        }

        .login-form {
            margin-bottom: 20px;
        }

        .login-form label {
            color: rgb(65, 64, 66);
            font-size: 1.2em;
            width: 80%;
        }

        .login-form input {
            padding: 10px;
            border: none;
            border-radius: 5px;
            width: 75%;
            font-size: 1.2em;
            background-color: rgb(194, 231, 245);

        }

        .login-form input:nth-child(2) {
            margin-bottom: 7%;
        }

        .login-error {
            color: rgb(150, 20, 20);
            background-color: rgb(255, 225, 225);
            border-radius: 5px;
            padding: 8px 12px;
            margin-bottom: 10px;
            width: 80%;
            text-align: center;
        }

        button {
            font-size: 1.5em;
            padding: 10px 25px;
            border: none;
            border-radius: 5px;
            color: white;
            background-color: rgb(0, 79, 104);
            cursor: pointer;
            transition: transform 0.2s ease, background-color 0.2s ease;
        }

        button:hover {
            transform: scale(1.05);
        }

        @media (max-width: 768px) {
            .login-container {
                width: 90%;
                min-width: unset;
                padding: 25px 15px;
                min-height: 360px;
            }

            .login-title {
                font-size: 1.5em;
            }

            .login-form label {
                width: 90%;
                font-size: 1.1em;
            }

            .login-form input {
                width: 85%;
                font-size: 16px;
            }

            .password-container {
                width: 90% !important;
            }

            button {
                font-size: 1.2em;
                width: 85%;
            }
        }
    </style>

</head>

<body>
    <div class="login-container">
        <h1 class="login-title">Sistema Soporte Técnico PV</h1>
        <% if (typeof error !== "undefined" && error) { %>
            <p class="login-error">Usuario o contraseña incorrectos.</p>
        <% } %>
        <form action="" method="post" class="login-form">
            <label for="usuario">Usuario:</label>
            <input type="text" name="usuario" id="usuario" placeholder="Ingrese el usuario" required>
            <label for="password">Contraseña:</label>
            <div class="password-container" style="width: 80%; position: relative; display: flex;">
                <input type="password" name="password" id="password" placeholder="Ingrese la contraseña"
                    style="width: 100% !important; padding-right: 40px !important;" required>
                <i class="bi bi-eye-fill toggle-password"
                    style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: rgb(0, 79, 104); font-size: 1.2em; z-index: 10;"></i>
            </div>
        </form>
        <button type="submit">Iniciar Sesión</button>
    </div>

    <script>
        const form = document.querySelector(".login-form");
        const boton = document.querySelector("button");
        boton.addEventListener("click", (e) => {
            e.preventDefault();
            form.submit();
        });

        form.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                form.submit();
            }
        });

        // Toggle password visibility functionality
        document.addEventListener("click", function (e) {
            if (e.target && e.target.classList.contains("toggle-password")) {
                const container = e.target.closest(".password-container");
                if (container) {
                    const input = container.querySelector("input");
                    if (input) {
                        if (input.type === "password") {
                            input.type = "text";
                            e.target.classList.remove("bi-eye-fill");
                            e.target.classList.add("bi-eye-slash-fill");
                        } else {
                            input.type = "password";
                            e.target.classList.remove("bi-eye-slash-fill");
                            e.target.classList.add("bi-eye-fill");
                        }
                    }
                }
            }
        });
    </script>
</body>

</html>