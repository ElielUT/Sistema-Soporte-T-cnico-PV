<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema Soporte Técnico PV</title>

    <style>
        * {
            padding: 0px;
            margin: 0px;
        }

        body {
            font-family: Helvetica, sans-serif;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: rgb(0, 79, 104);
        }

        .login-container {
            display: flex;
            flex-direction: column;
            justify-content: space-around;
            align-items: center;
            background-color: rgb(115, 209, 245);
            border-radius: 5%;
            height: 50vh;
            width: 25%;
            box-shadow: 10px 10px 10px 10px rgba(0, 0, 0, 0.5);
        }

        .login-title {
            color: rgb(0, 79, 104);
            margin-top: 15px;
            margin-bottom: 20px;
            font-size: 2em;
            font-weight: bold;
            text-align: center;
        }

        .login-form {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 100%;
            align-items: center;
        }

        .login-form {
            margin-bottom: 20px;
        }

        .login-form label {
            color: rgb(65, 64, 66);
            font-size: 1.2em;
            width: 80%;
        }

        .login-form input {
            padding: 10px;
            border: none;
            border-radius: 5px;
            width: 75%;
            font-size: 1.2em;
            background-color: rgb(194, 231, 245);

        }

        .login-form input:nth-child(2) {
            margin-bottom: 7%;
        }

        button {
            font-size: 1.5em;
            padding: 10px;
            border: none;
            border-radius: 5px;
            color: white;
            background-color: rgb(0, 79, 104);
            cursor: pointer;
        }
    </style>

</head>

<body>
    <div class="login-container">
        <h1 class="login-title">Sistema Soporte Técnico PV</h1>
        <form action="" method="post" class="login-form">
            <label for="usuario">Usuario:</label>
            <input type="text" name="usuario" id="usuario" placeholder="Ingrese el usuario">
            <label for="password">Contraseña:</label>
            <input type="password" name="password" id="password" placeholder="Ingrese la contraseña">
        </form>
        <button type="submit">Iniciar Sesión</button>
    </div>

    <script>
        const form = document.querySelector(".login-form");
        const boton = document.querySelector("button");
        boton.addEventListener("click", (e) => {
            e.preventDefault();
            form.submit();
        });

        form.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                form.submit();
            }
        });
    </script>
</body>

</html>