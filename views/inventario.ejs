<%- include('templates/header.ejs') %>
    <h1>Inventario</h1>

    <div class="buscador">
        <form action="" id="formBusqueda" class="formBusqueda">
            <input type="text" name="Buscar" placeholder="Buscar">
            <%- include("templates/select", { nombre: "categoria", placeholder: "Todos", opciones: catalogos.categoriasInventario }) %>
        </form>

        <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
    </div>

    <%- include("templates/form_nuevo", { campos: "campos/inventario" }) %>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Cantidad</th>
                <th>Medida</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(item=> { %>
                <tr id="<%= item.idinvt %>" data-producto="<%= item.producto %>" data-categoria="<%= item.categoria %>"
                    data-cantidad="<%= item.cantidad %>" data-medida="<%= item.medida %>"
                    data-unmed="<%= item.unmed %>">
                    <td>
                        <%= item.idinvt %>
                    </td>
                    <td>
                        <%= item.producto %>
                    </td>
                    <td>
                        <%= item.categoria %>
                    </td>
                    <td>
                        <%= item.cantidad %>
                    </td>
                    <td>
                        <%= item.medida %>
                            <%= item.unmed %>
                    </td>
                    <%- include("templates/acciones", { subcategoria: item.subcategoria }) %>
                </tr>
                <% }) %>
        </tbody>
    </table>
    </div>

    <%- include("templates/form_editar", { campos: "campos/inventario" }) %>

        <script>
            window.paginaActual = "/inventario"
        </script>
        <%- include('templates/footer.ejs') %>
