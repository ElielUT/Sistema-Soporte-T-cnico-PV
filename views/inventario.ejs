<%- include('templates/header.ejs') %>
    <h1>Inventario</h1>

    <div class="buscador">
        <form action="">
            <input type="text" name="Buscar" placeholder="Buscar">
            <select name="categoria" id="">
                <option value="">Todos</option>
            </select>
        </form>

        <button class="nuevo">+ Nuevo</button>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Cantidad</th>
                <th>Medida</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(item=> { %>
                <tr>
                    <td>
                        <%= item.idinvt %>
                    </td>
                    <td>
                        <%= item.producto %>
                    </td>
                    <td>
                        <%= item.categoria %>
                    </td>
                    <td>
                        <%= item.cantidad %>
                    </td>
                    <td>
                        <%= item.medida %>
                            <%= item.unmed %>
                    </td>
                    <td id="<%= item.idinvt %>" style="width: 50px; text-align: center;">
                        <i class="bi bi-trash-fill eliminar"></i>
                        <i class="bi bi-pencil-fill editar"></i>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
    <%- include('templates/footer.ejs') %>