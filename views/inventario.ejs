<%- include('templates/header.ejs') %>
    <h1>Inventario</h1>

    <div class="buscador">
        <form action="" id="formBusqueda" class="formBusqueda">
            <input type="text" name="Buscar" placeholder="Buscar">
            <select name="categoria" id="">
                <option value="">Todos</option>
            </select>
        </form>

        <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
    </div>

    <div class="ingresar ocultar modales" id="formNuevo">
        <div class="botones">
            <button class="cancelar"><b>Cancelar</b></button>
            <button class="agregar" id="agregar"><b>+ Agregar</b></button>
        </div>

        <form action="">
            <div class="tres">
                <input type="text" placeholder="Producto" name="Producto">
                <select name="categoria" id="">
                    <option value="">Categoría</option>
                </select>
                <input type="number" name="cantidad" id="" placeholder="Cantidad" min="0">
            </div>
            <div class="dosUno">
                <input type="number" name="medida" id="" placeholder="Medida" min="0">
                <select name="medida" id="">
                    <optgroup label="Peso">
                        <option value="kg">Kg</option>
                        <option value="gr">Gr</option>
                        <option value="mg">Mg</option>
                    </optgroup>
                    <optgroup label="Litros">
                        <option value="lt">Lt</option>
                        <option value="ml">Ml</option>
                    </optgroup>
                    <optgroup label="Metros">
                        <option value="m">M</option>
                        <option value="cm">Cm</option>
                        <option value="mm">Mm</option>
                    </optgroup>
                    <optgroup label="Otra">
                        <option value="u" selected>Unidad</option>
                        <option value="">Ninguna</option>
                    </optgroup>
                </select>
            </div>
            <div class="solo">
                <input type="checkbox" name="subcategoria" id="">
                <label for="subcategoria"><b>Subcategoria</b></label>
            </div>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Cantidad</th>
                <th>Medida</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(item=> { %>
                <tr id="<%= item.idinvt %>">
                    <td>
                        <%= item.idinvt %>
                    </td>
                    <td>
                        <%= item.producto %>
                    </td>
                    <td>
                        <%= item.categoria %>
                    </td>
                    <td>
                        <%= item.cantidad %>
                    </td>
                    <td>
                        <%= item.medida %>
                            <%= item.unmed %>
                    </td>
                    <td style="width: 50px; text-align: center;">
                        <i class="bi bi-trash-fill eliminar"></i>
                        <i class="bi bi-pencil-fill editar"></i>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
    </div>
    <div class="contenedorForm ocultar modales" id="formEditar">
        <div class="formEditar ingresar">
            <div class="botones">
                <button class="cancelar"><b>Cancelar</b></button>
                <button class="actualizar" id="actualizar"><b>Actualizar</b></button>
            </div>

            <form action="">
                <div class="tres">
                    <input type="text" placeholder="Producto" name="Producto">
                    <select name="categoria" id="">
                        <option value="">Categoría</option>
                    </select>
                    <input type="number" name="cantidad" id="" placeholder="Cantidad" min="0">
                </div>
                <div class="dosUno">
                    <input type="number" name="medida" id="" placeholder="Medida" min="0">
                    <select name="medida" id="">
                        <optgroup label="Peso">
                            <option value="kg">Kg</option>
                            <option value="gr">Gr</option>
                            <option value="mg">Mg</option>
                        </optgroup>
                        <optgroup label="Litros">
                            <option value="lt">Lt</option>
                            <option value="ml">Ml</option>
                        </optgroup>
                        <optgroup label="Metros">
                            <option value="m">M</option>
                            <option value="cm">Cm</option>
                            <option value="mm">Mm</option>
                        </optgroup>
                        <optgroup label="Otra">
                            <option value="u" selected>Unidad</option>
                            <option value="">Ninguna</option>
                        </optgroup>
                    </select>
                </div>
            </form>
        </div>


        <script>
            window.paginaActual = "/inventario"
        </script>
        <%- include('templates/footer.ejs') %>