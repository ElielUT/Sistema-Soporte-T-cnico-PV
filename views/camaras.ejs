<%- include("templates/header.ejs") %>
    <h1>Cámaras</h1>
    <div class="buscador">
        <form action="" id="formBusqueda" class="formBusqueda">
            <input type="text" name="Buscar" placeholder="Buscar" style="width: 100%;">
        </form>

        <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
    </div>

    <%- include("templates/form_nuevo", { campos: "campos/camaras" }) %>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Dirección IP</th>
                <th>Ubicación</th>
                <th>Conexión</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(item=> { %>
                <tr id="<%= item.idcamara %>" data-nombre="<%= item.nombre %>" data-direccioip="<%= item.direccioip %>"
                    data-ubicacion="<%= item.ubicacion %>" data-conexion="<%= item.conexion %>"
                    data-idprod2="<%= item.idprod2 %>">
                    <td>
                        <%= item.idcamara %>
                    </td>
                    <td>
                        <%= item.nombre %>
                    </td>
                    <td>
                        <%= item.direccioip %>
                    </td>
                    <td>
                        <%= item.ubicacion %>
                    </td>
                    <td>
                        <%= item.conexion %>
                    </td>
                    <%- include("templates/acciones", { subcategoria: item.subcategoria }) %>
                </tr>
                <% }) %>
        </tbody>
    </table>
    </div>

    <%- include("templates/form_editar", { campos: "campos/camaras" }) %>

        <script>
            window.paginaActual = "/camara"
        </script>
        <%- include("templates/footer.ejs") %>
