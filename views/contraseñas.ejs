<%- include("templates/header.ejs") %>
    <%- include("templates/secciones", { titulo: "Recursos", botones: [
        { id: "btnContraseñas", texto: "Contraseñas", activo: true },
        { id: "btnDocumentos", texto: "Documentos", activo: false }
    ] }) %>

    <div class="seccion">
        <div class="buscador">
            <form action="" id="formBusqueda" class="formBusqueda">
                <input type="text" name="Buscar" placeholder="Buscar">
                <%- include("templates/select", { nombre: "categoria", placeholder: "Todas", opciones: catalogos.categoriasContrasenas }) %>
            </form>

            <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
        </div>

        <%- include("templates/form_nuevo", { campos: "campos/contrasenas" }) %>

        <table>
            <thead>
                <tr>
                    <th>
                        ID
                    </th>
                    <th>
                        Nombre
                    </th>
                    <th>
                        Categoría
                    </th>
                    <th>
                        Password
                    </th>
                    <th>
                        Usuario
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% data.forEach(item=> { %>
                    <tr id="<%= item.id_pass %>" data-nombre="<%= item.nombre %>" data-categoria="<%= item.categoria %>"
                        data-password="<%= item.password %>" data-usuario="<%= item.usuario %>">
                        <td>
                            <%= item.id_pass %>
                        </td>
                        <td>
                            <%= item.nombre %>
                        </td>
                        <td>
                            <%= item.categoria %>
                        </td>
                        <td>
                            <div class="password-container table-password">
                                <input type="password" value="<%= item.password %>" readonly
                                    class="table-password-input">
                                <i class="bi bi-eye-fill toggle-password"></i>
                            </div>
                        </td>
                        <td>
                            <%= item.usuario %>
                        </td>
                        <%- include("templates/acciones") %>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
    </div>

    <%- include("templates/form_editar", { campos: "campos/contrasenas" }) %>

        <script>
            window.paginaActual = "/passwords"
        </script>
        <script src="js/recursos.js"></script>
        <%- include("templates/footer.ejs") %>
