<%- include("templates/header.ejs") %>
    <%- include("templates/secciones", { titulo: "Recursos", botones: [
        { id: "btnContraseñas", texto: "Contraseñas", activo: false },
        { id: "btnDocumentos", texto: "Documentos", activo: true }
    ] }) %>

    <div class="seccion">
        <div class="buscador">
            <form action="" id="formBusqueda" class="formBusqueda">
                <input type="text" name="Buscar" placeholder="Buscar">
                <%- include("templates/select", { nombre: "categoria", placeholder: "Todas", opciones: catalogos.categoriasDocumentos }) %>
            </form>

            <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
        </div>

        <%- include("templates/form_nuevo", { campos: "campos/documentos" }) %>

        <table>
            <thead>
                <tr>
                    <th>
                        ID
                    </th>
                    <th>
                        Nombre
                    </th>
                    <th>
                        Categoría
                    </th>
                    <th style="width: 80px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof data !== 'undefined' && data && data.length > 0) { %>
                    <% data.filter(item => item.name !== '.emptyFolderPlaceholder').forEach((item, index) => { 
                        const nombreDoc = item.name || item.nombre || '';
                        const idDoc = item.id_doc || item.id || (index + 1);
                        const catDoc = item.categoria || (item.metadata && item.metadata.mimetype) || 'Documento';
                    %>
                        <tr id="<%= idDoc %>" data-nombre="<%= nombreDoc %>" data-categoria="<%= catDoc %>">
                            <td>
                                <%= idDoc %>
                            </td>
                            <td>
                                <%= nombreDoc %>
                            </td>
                            <td>
                                <%= catDoc %>
                            </td>
                            <td style="width: 80px; text-align: center;">
                                <a href="<%= urlApi %>/documento/<%= encodeURIComponent(nombreDoc) %>" download="<%= nombreDoc %>" title="Descargar" style="text-decoration: none; color: inherit; margin-right: 8px;">
                                    <i class="bi bi-download descargar" style="cursor: pointer; font-size: 1.1rem;"></i>
                                </a>
                                <i class="bi bi-trash-fill eliminar" style="cursor: pointer; font-size: 1.1rem; color: #dc3545;" title="Eliminar"></i>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align: center; color: #888;">No hay documentos disponibles</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
    </div>

    <%- include("templates/form_editar", { campos: "campos/documentos" }) %>

        <script>
            window.paginaActual = "/documento"
        </script>
        <script src="js/recursos.js"></script>

        <%- include("templates/footer.ejs") %>
