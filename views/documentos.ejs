<%- include("templates/header.ejs") %>
    <div class="superior">
        <h1>Recursos</h1>
        <div class="secciones">
            <button class="btn-seccion" id="btnContraseñas">Contraseñas</button>
            <button class="btn-seccion seleccionado" id="btnDocumentos">Documentos</button>
        </div>
    </div>

    <div class="seccion">
        <div class="buscador">
            <form action="" id="formBusqueda" class="formBusqueda">
                <input type="text" name="Buscar" placeholder="Buscar">
                <select name="categoria" id="">
                    <option value="">Todas</option>
                    <option value="Instrucciones">Instrucciones</option>
                    <option value="Formatos">Formatos</option>
                    <option value="Reportes">Reportes</option>
                    <option value="Plantillas">Plantillas</option>
                    <option value="Otros">Otros</option>
                </select>
            </form>

            <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
        </div>

        <div class="ingresar ocultar modales" id="formNuevo">
            <div class="botones">
                <button class="cancelar"><b>Cancelar</b></button>
                <button class="agregar" id="agregar"><b>+ Agregar</b></button>
            </div>

            <form action="">
                <div class="dosUno">
                    <input type="file" name="archivo" id="inputArchivo" placeholder="Archivo" style="padding: 0px;" required>
                    <select name="categoria" id="">
                        <option value="">Categoría</option>
                        <option value="Instrucciones">Instrucciones</option>
                        <option value="Formatos">Formatos</option>
                        <option value="Reportes">Reportes</option>
                        <option value="Plantillas">Plantillas</option>
                        <option value="Otros">Otros</option>
                    </select>
                </div>
            </form>
        </div>

        <table>
            <thead>
                <tr>
                    <th>
                        ID
                    </th>
                    <th>
                        Nombre
                    </th>
                    <th>
                        Categoría
                    </th>
                    <th style="width: 80px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof data !== 'undefined' && data && data.length > 0) { %>
                    <% data.filter(item => item.name !== '.emptyFolderPlaceholder').forEach((item, index) => { 
                        const nombreDoc = item.name || item.nombre || '';
                        const idDoc = item.id || (index + 1);
                        const catDoc = item.categoria || (item.metadata && item.metadata.mimetype) || 'Documento';
                    %>
                        <tr id="<%= idDoc %>" data-nombre="<%= nombreDoc %>" data-categoria="<%= catDoc %>">
                            <td>
                                <%= idDoc %>
                            </td>
                            <td>
                                <%= nombreDoc %>
                            </td>
                            <td>
                                <%= catDoc %>
                            </td>
                            <td style="width: 80px; text-align: center;">
                                <a href="<%= urlApi %>/documento/<%= encodeURIComponent(nombreDoc) %>" download="<%= nombreDoc %>" title="Descargar" style="text-decoration: none; color: inherit;">
                                    <i class="bi bi-download descargar" style="cursor: pointer; font-size: 1.1rem;"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align: center; color: #888;">No hay documentos disponibles</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
    </div>

    <div class="contenedorForm ocultar modales" id="formEditar">
        <div class="formEditar ingresar">
            <div class="botones">
                <button class="cancelar"><b>Cancelar</b></button>
                <button class="actualizar" id="actualizar"><b>Actualizar</b></button>
            </div>

            <form action="">
                <div class="dosUno">
                    <input type="file" name="archivo" id="" placeholder="Archivo" style="padding: 0px;">
                    <select name="categoria" id="">
                        <option value="">Categoría</option>
                        <option value="Instrucciones">Instrucciones</option>
                        <option value="Formatos">Formatos</option>
                        <option value="Reportes">Reportes</option>
                        <option value="Plantillas">Plantillas</option>
                        <option value="Otros">Otros</option>
                    </select>
                </div>
            </form>
        </div>

        <script>
            window.paginaActual = "/documento"
        </script>
        <script src="js/recursos.js"></script>

        <%- include("templates/footer.ejs") %>