<%- include ("templates/header_superior", {titulo: "Mantenimiento" , pagAnterior: "/proceso" }) %>
    <div class="buscador">
        <form action="" id="formBusqueda" class="formBusqueda">
            <input type="text" name="Buscar" placeholder="Buscar" style="width: 100%;">
        </form>

        <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
    </div>

    <div class="ingresar ocultar modales" id="formNuevo">
        <div class="botones">
            <button class="cancelar"><b>Cancelar</b></button>
            <button class="agregar" id="agregar"><b>+ Agregar</b></button>
        </div>

        <form action="">
            <div class="dosUnoR">
                <input type="hidden" name="idproc1" id="idproc1" value="<%= idproc1 %>">
                <select name="idinvt2" id="" data-searchable="true">
                    <option value="" disabled selected>Seleccione un producto</option>
                    <% inventario.forEach(inv=> { %>
                        <option value="<%= inv.idinvt %>">
                            <%= inv.producto %>
                        </option>
                        <% }) %>
                </select>
                <input type="number" name="cantidad" id="" placeholder="Cantidad" min="0">
            </div>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% items.forEach(item=> { %>
                <tr id="<%= item.idutiliza %>" data-idproc1="<%= item.idproc1 %>" data-idinvt2="<%= item.idinvt2 %>"
                    data-cantidad="<%= item.cantidad %>">
                    <td>
                        <%= inventario.find(inv=> inv.idinvt === item.idinvt2)?.producto || 'N/A' %>
                    </td>
                    <td>
                        <%= item.cantidad %>
                    </td>
                    <td style="width: 50px; text-align: center;">
                        <i class="bi bi-trash-fill eliminar"></i>
                        <i class="bi bi-pencil-fill editar"></i>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
    </div>
    <div class="contenedorForm ocultar modales" id="formEditar">
        <div class="formEditar ingresar">
            <div class="botones">
                <button class="cancelar"><b>Cancelar</b></button>
                <button class="actualizar" id="actualizar"><b>Actualizar</b></button>
            </div>

            <form action="">
                <input type="hidden" name="idproc1" id="idproc1" value="<%= idproc1 %>">
                <div class="dosUnoR">
                    <select name="idinvt2" id="" data-searchable="true">
                        <option value="" disabled selected>Seleccione un producto</option>
                        <% inventario.forEach(inv=> { %>
                            <option value="<%= inv.idinvt %>">
                                <%= inv.producto %>
                            </option>
                            <% }) %>
                    </select>
                    <input type="number" name="cantidad" id="" placeholder="Cantidad" min="0">
                </div>
            </form>
        </div>

        <script src="/js/searchable-select.js"></script>
        <script>
            window.paginaActual = "/utiliza"
        </script>
        <%- include ("templates/footer") %>