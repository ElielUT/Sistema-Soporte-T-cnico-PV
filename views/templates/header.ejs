<!DOCTYPE html>
<html lang="es">

<%- include("head") %>

<body>
    <button class="mobile-toggle-btn" id="mobileToggleBtn" aria-label="Abrir menú">
        <i class="bi bi-list"></i>
    </button>
    <div class="menu-overlay" id="menuOverlay"></div>

    <div class="menu" id="sideMenu">
        <div class="menTitulo">
            <button class="close-menu-btn" id="closeMenuBtn" aria-label="Cerrar menú">
                <i class="bi bi-x-lg"></i>
            </button>
            <img src="/images/logo.png" alt="Logo">
            <br>
            <h1>Soporte Técnico</h1>
        </div>
        <div class="menEnlaces">
            <a href="/inventario"><b>Inventario</b></a>
            <a href="/camaras"><b>Cámaras</b></a>
            <a href="/antenas"><b>Antenas</b></a>
            <a href="/contrasenas"><b>Recursos</b></a>
            <a href="/mantenimientos"><b>Mantenimientos</b></a>
        </div>
    </div>
    <div class="contenido">

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("mobileToggleBtn");
            const closeBtn = document.getElementById("closeMenuBtn");
            const sideMenu = document.getElementById("sideMenu");
            const overlay = document.getElementById("menuOverlay");

            function openMenu() {
                if (sideMenu) sideMenu.classList.add("menu-abierto");
                if (overlay) overlay.classList.add("overlay-activo");
            }

            function closeMenu() {
                if (sideMenu) sideMenu.classList.remove("menu-abierto");
                if (overlay) overlay.classList.remove("overlay-activo");
            }

            if (toggleBtn) toggleBtn.addEventListener("click", openMenu);
            if (closeBtn) closeBtn.addEventListener("click", closeMenu);
            if (overlay) overlay.addEventListener("click", closeMenu);
        });
    </script>