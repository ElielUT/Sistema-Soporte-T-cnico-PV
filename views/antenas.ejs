<%- include("templates/header.ejs") %>
    <h1>Antenas</h1>
    <div class="buscador">
        <form action="" id="formBusqueda" class="formBusqueda">
            <input type="text" name="Buscar" placeholder="Buscar" style="width: 100%;">
        </form>

        <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
    </div>

    <div class="ingresar ocultar modales" id="formNuevo">
        <div class="botones">
            <button class="cancelar"><b>Cancelar</b></button>
            <button class="agregar" id="agregar"><b>+ Agregar</b></button>
        </div>

        <form action="">
            <div class="tres">
                <select name="idprod1" id="">
                    <option value="">Seleccione un producto</option>
                    <% productos.forEach(prod=> { %>
                        <option value="<%= prod.idprod %>">
                            <%= prod.modelo %>
                                <%= prod.noserie %>
                        </option>
                        <% }) %>
                </select>
                <input type="text" name="nombre" id="" placeholder="Nombre">
                <input type="text" name="direccionip" id="" placeholder="Dirección IP">
            </div>
            <div class="dos">
                <input type="text" name="ubicacion" id="" placeholder="Ubicación">
                <input type="text" name="puertoswitch" id="" placeholder="Puerto Switch">
            </div>
            <div class="dos">
                <input type="text" name="usuario" id="" placeholder="Usuario">
                <input type="text" name="contrasena" id="" placeholder="Contraseña">
            </div>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Dirección IP</th>
                <th>Ubicación</th>
                <th>Usuario / Contraseña</th>
                <th>Puerto</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(item=> { %>
                <tr id="<%= item.idantena %>" data-nombre="<%= item.nombre %>"
                    data-direccionip="<%= item.direccionip %>" data-ubicacion="<%= item.ubicacion %>"
                    data-puertoswitch="<%= item.puertoswitch %>" data-usuario="<%= item.usuario %>"
                    data-contrasena="<%= item.contrasena %>" data-idprod1="<%= item.idprod1 %>">
                    <td>
                        <%= item.idantena %>
                    </td>
                    <td>
                        <%= item.nombre %>
                    </td>
                    <td>
                        <%= item.direccionip %>
                    </td>
                    <td>
                        <%= item.ubicacion %>
                    </td>
                    <td>
                        <%= item.usuario %>
                            <%= item.contrasena %>
                    </td>
                    <td>
                        <%= item.puertoswitch %>
                    </td>
                    <td style="width: 50px; text-align: center;">
                        <form action=""><input type="hidden" name="subcategoria" value="<%= item.subcategoria %>">
                        </form>
                        <i class="bi bi-trash-fill eliminar"></i>
                        <i class="bi bi-pencil-fill editar"></i>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
    </div>

    <div class="contenedorForm ocultar modales" id="formEditar">
        <div class="formEditar ingresar">
            <div class="botones">
                <button class="cancelar"><b>Cancelar</b></button>
                <button class="actualizar" id="actualizar"><b>Actualizar</b></button>
            </div>

            <form action="">
                <div class="tres">
                    <select name="idprod1" id="">
                        <option value="">Seleccione un producto</option>
                        <% productos.forEach(prod=> { %>
                            <option value="<%= prod.idprod %>">
                                <%= prod.modelo %>
                                    <%= prod.noserie %>
                            </option>
                            <% }) %>
                    </select>
                    <input type="text" name="nombre" id="" placeholder="Nombre">
                    <input type="text" name="direccionip" id="" placeholder="Dirección IP">
                </div>
                <div class="dos">
                    <input type="text" name="ubicacion" id="" placeholder="Ubicación">
                    <input type="text" name="puertoswitch" id="" placeholder="Puerto Switch">
                </div>
                <div class="dos">
                    <input type="text" name="usuario" id="" placeholder="Usuario">
                    <input type="text" name="contrasena" id="" placeholder="Contraseña">
                </div>
            </form>
        </div>

        <script>
            window.paginaActual = "/antena"
        </script>
        <%- include("templates/footer.ejs") %>