<%- include ("templates/header") %>
    <div class="superior">
        <h1>Mantenimientos</h1>

        <div class="secciones">
            <button class="btn-seccion" id="btnTodos">Tipos</button>
            <button class="btn-seccion seleccionado" id="btnRealizados">Realizados</button>
        </div>
    </div>

    <div class="seccion" id="tipos">
        <div class="buscador">
            <form action="" id="formBusqueda" class="formBusqueda">
                <input type="text" name="Buscar" placeholder="Buscar">
                <select name="areas" id="">
                    <option value="">Todas</option>
                    <option value="Administración">Administración</option>
                    <option value="Soporte Técnico">Soporte Técnico</option>
                    <option value="Instituto Bíblico">Instituto Bíblico</option>
                    <option value="Alcance">Alcance</option>
                </select>
                <input type="date" name="fecha" id="" placeholder="Fecha">
            </form>

            <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
        </div>

        <div class="ingresar ocultar modales" id="formNuevo">
            <div class="botones">
                <button class="cancelar"><b>Cancelar</b></button>
                <button class="agregar" id="agregar"><b>+ Agregar</b></button>
            </div>

            <form action="">
                <div class="dosUno1">
                    <select name="idmant1" id="">
                        <option value="">Seleccione un mantenimiento</option>
                        <% mantenimientos.forEach(mant=> { %>
                            <option value="<%= mant.idmant %>">
                                <%= mant.areas %> - Día <%= mant.dia %> / Mes <%= mant.mes %>
                            </option>
                            <% }) %>
                    </select>
                    <input type="date" name="realizado" id="" placeholder="Fecha">
                </div>
            </form>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Área</th>
                    <th>Fecha</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% data.forEach(item=> { %>
                    <tr id="<%= item.idproc %>" data-realizado="<%= item.realizado %>"
                        data-idmant1="<%= item.idmant1 %>">
                        <td class="btnUtiliza" style="cursor: pointer;">
                            <%= item.idproc %>
                        </td>
                        <td>
                            <%= item.mantenimientos ? item.mantenimientos.areas : 'N/A' %>
                        </td>
                        <td>
                            <%= item.realizado %>
                        </td>
                        <td style="width: 50px; text-align: center;">
                            <i class="bi bi-trash-fill eliminar"></i>
                            <i class="bi bi-pencil-fill editar"></i>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
    </div>

    <div class="contenedorForm ocultar modales" id="formEditar">
        <div class="formEditar ingresar">
            <div class="botones">
                <button class="cancelar"><b>Cancelar</b></button>
                <button class="actualizar" id="actualizar"><b>Actualizar</b></button>
            </div>

            <form action="">
                <div class="dosUno1">
                    <select name="idmant1" id="">
                        <option value="">Seleccione un mantenimiento</option>
                        <% mantenimientos.forEach(mant=> { %>
                            <option value="<%= mant.idmant %>">
                                <%= mant.areas %> - Día <%= mant.dia %> / Mes <%= mant.mes %>
                            </option>
                            <% }) %>
                    </select>
                    <input type="date" name="realizado" id="" placeholder="Fecha">
                </div>
            </form>
        </div>

        <script>
            window.paginaActual = "/proceso"
        </script>
        <script src="js/secciones.js"></script>

        <%- include ("templates/footer") %>