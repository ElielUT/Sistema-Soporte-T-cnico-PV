<%- include ("templates/header") %>
    <%- include("templates/secciones", { titulo: "Mantenimientos", botones: [
        { id: "btnTodos", texto: "Tipos", activo: false },
        { id: "btnRealizados", texto: "Realizados", activo: true }
    ] }) %>

    <div class="seccion" id="tipos">
        <div class="buscador">
            <form action="" id="formBusqueda" class="formBusqueda">
                <input type="text" name="Buscar" placeholder="Buscar">
                <%- include("templates/select", { nombre: "areas", placeholder: "Todas", opciones: catalogos.areas }) %>
                <input type="date" name="fecha" id="" placeholder="Fecha">
            </form>

            <button class="nuevo" id="nuevo"><b>+ Nuevo</b></button>
        </div>

        <%- include("templates/form_nuevo", { campos: "campos/proceso" }) %>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Área</th>
                    <th>Fecha</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% data.forEach(item=> { %>
                    <tr id="<%= item.idproc %>" data-realizado="<%= item.realizado %>"
                        data-idmant1="<%= item.idmant1 %>">
                        <td class="btnUtiliza" style="cursor: pointer;">
                            <%= item.idproc %>
                        </td>
                        <td>
                            <%= item.mantenimientos ? item.mantenimientos.areas : 'N/A' %>
                        </td>
                        <td>
                            <%= item.realizado %>
                        </td>
                        <%- include("templates/acciones") %>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
    </div>

    <%- include("templates/form_editar", { campos: "campos/proceso" }) %>

        <script>
            window.paginaActual = "/proceso"
        </script>
        <script src="js/secciones.js"></script>

        <%- include ("templates/footer") %>
